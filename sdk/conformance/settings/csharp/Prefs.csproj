<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SDK conformance plugin in C#: its describe mode must print the same
       descriptor as the Rust and TypeScript ones (sdk/conformance/settings/descriptor.json). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Prefs</AssemblyName>
    <RootNamespace>Prefs</RootNamespace>
    <!-- The plugin version: Plugin.Create("prefs") reads it from the assembly. -->
    <Version>0.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/Celobus.Sdk/Celobus.Sdk.csproj" />
  </ItemGroup>
</Project>
