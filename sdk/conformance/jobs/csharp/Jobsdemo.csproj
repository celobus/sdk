<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SDK conformance plugin of background jobs in C#: its describe mode must print the same
       descriptor as the Rust and TypeScript ones (sdk/conformance/jobs/descriptor.json). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Jobsdemo</AssemblyName>
    <RootNamespace>Jobsdemo</RootNamespace>
    <!-- The plugin version: Plugin.Create("jobsdemo") reads it from the assembly. -->
    <Version>0.1.0</Version>
  </PropertyGroup>
  <!-- what the package gives a plugin: `File` is Celobus.Sdk.File, not System.IO.File -->
  <Import Project="../../../dotnet/Celobus.Sdk/build/Celobus.Sdk.props" />
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/Celobus.Sdk/Celobus.Sdk.csproj" />
  </ItemGroup>
</Project>
