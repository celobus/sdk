<Project Sdk="Microsoft.NET.Sdk">
  <!-- The SDK conformance plugin `shop` in C# (a UI with screens, a dialog form, a live badge and topics): its describe
       mode must print the same descriptor as the Rust and TypeScript ones (sdk/conformance/shop/descriptor.json). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Shop</AssemblyName>
    <RootNamespace>Shop</RootNamespace>
    <!-- The plugin version: Plugin.Create("shop") reads it from the assembly. -->
    <Version>1.0.0</Version>
  </PropertyGroup>
  <!-- what the package gives a plugin: `File` is Celobus.Sdk.File, not System.IO.File -->
  <Import Project="../../../dotnet/Celobus.Sdk/build/Celobus.Sdk.props" />
  <ItemGroup>
    <ProjectReference Include="../../../dotnet/Celobus.Sdk/Celobus.Sdk.csproj" />
  </ItemGroup>
</Project>
