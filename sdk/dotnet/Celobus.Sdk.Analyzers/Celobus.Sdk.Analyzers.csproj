<Project Sdk="Microsoft.NET.Sdk">
  <!-- The analyzers of Celobus.Sdk: CELOBUS060, a construct a query (ctx.Query<T>() and LINQ) cannot translate. They
       ship inside the Celobus.Sdk package (analyzers/dotnet/cs), never as a package of their own; a plugin built
       against the SDK's source references this project as an analyzer (OutputItemType="Analyzer",
       ReferenceOutputAssembly="false"). -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>false</IsPackable>
    <!-- release tracking files (RS2008) are for analyzers shipped as packages -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" PrivateAssets="all" />
  </ItemGroup>
</Project>
